{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",                    // Keep commonjs
    "moduleResolution": "node",              // Change moduleResolution to node
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "strict": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
