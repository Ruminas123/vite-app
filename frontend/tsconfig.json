{
  "compilerOptions": {
    "target": "ES6",
    "module": "Node16",                     // Change this to Node16
    "moduleResolution": "node16",           // Keep this as node16
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "strict": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
